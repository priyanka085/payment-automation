{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["status", "transactionId", "amount", "currency"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["APPROVED", "DECLINED"]
    },
    "transactionId": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    }
  }
}